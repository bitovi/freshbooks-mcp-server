# ── Required ──────────────────────────────────────────────────────────────────
# Create a FreshBooks app at https://my.freshbooks.com/#/developer
FRESHBOOKS_CLIENT_ID=your_client_id_here
FRESHBOOKS_CLIENT_SECRET=your_client_secret_here

# ── HTTP / Custom Connector mode ───────────────────────────────────────────────
# Set MODE=http to run as an HTTP server (for claude.ai custom connector)
# Defaults to stdio (for MCP inspector / Claude Desktop)
MODE=http

# Public base URL of this server (used to build the OAuth redirect URI)
# Defaults to https://localhost:3443 — override for production
# SERVER_URL=https://freshbooks-mcp.yourdomain.com

# Port for the HTTP server (defaults to 3443 for HTTPS mode, 3000 for plain HTTP)
# PORT=3443

# Set to false when running behind ngrok or another TLS proxy (they handle HTTPS)
# HTTPS=false

# ── Stdio mode ─────────────────────────────────────────────────────────────────
# When MODE=stdio (default), you can supply a pre-obtained FreshBooks access
# token directly so no browser OAuth is needed.
# FRESHBOOKS_ACCESS_TOKEN=your_access_token_here
# FRESHBOOKS_REFRESH_TOKEN=your_refresh_token_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Override the FreshBooks API base (rarely needed)
# FRESHBOOKS_API_BASE=https://api.freshbooks.com
