# Required by the org's "Security & supply-chain gate" ruleset (checked by the
# `policy` PR check) on any repo whose PR touches package.json. Only applies to
# `npm install`/lockfile resolution — this repo's CI and Docker builds use
# `npm ci`, which installs strictly from package-lock.json and ignores this
# setting, so it doesn't change what actually gets installed here.
min-release-age=7
