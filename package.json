{
  "name": "freshbooks-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for the FreshBooks API — works as a claude.ai custom connector (HTTP/SSE) or local MCP inspector target (stdio)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "freshbooks-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc --noEmit",
    "dev": "node --env-file=.env --import tsx/esm src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "serve": "MODE=http node --env-file=.env dist/index.js",
    "dev:http": "MODE=http node --env-file=.env --import tsx/esm src/index.ts",
    "auth-url": "node --env-file=.env --import tsx/esm src/scripts/auth-url.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "axios": "^1.18.0",
    "express": "^4.19.0",
    "selfsigned": "^5.5.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0"
  }
}
